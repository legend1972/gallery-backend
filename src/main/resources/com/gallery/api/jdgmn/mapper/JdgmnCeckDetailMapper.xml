<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.gallery.api.jdgmn.mapper.JdgmnCeckDetailMapper">
    <insert id="insertListJdgmnCeckDetail" parameterType="com.gallery.api.jdgmn.dto.JdgmnCeckDetailBindingDto">
        <selectKey keyProperty="jdgmnNo"
                   resultType="string"
                   order="BEFORE">
            select 'JDN' || lpad(nextval('jdgmn_no')::text, 9, '0')
        </selectKey>
            insert into jdgmn_ceck_detail
            (
                jdgmn_no,
                jdgmn_ceck_code,
                mber_no,
                ceck_at,
                creat_mber_no,
                creat_dt,
                change_mber_no,
                change_dt
            )
            values
            <foreach collection="jdgmnCeckDetailList" item="item" separator=",">
            (
                #{jdgmnNo},
                #{item.jdgmnCeckCode},
                #{item.mberNo},
                #{item.ceckAt},
                #{item.creatMberNo},
                CURRENT_TIMESTAMP,
                #{item.changeMberNo},
                CURRENT_TIMESTAMP
            )
            </foreach>
    </insert>

    <select id="selectListJdgmnCeckDetailByJdgmnNo" parameterType="string" resultType="com.gallery.api.jdgmn.entity.JdgmnCeckDetailEntity">
        select jdgmn_no
            , jdgmn_ceck_code
            , mber_no
            , ceck_at
            , creat_mber_no
            , creat_dt
            , change_mber_no
            , change_dt
        from jdgmn_ceck_detail
        where jdgmn_no = #{jdgmnNo}
    </select>

    <delete id="deleteListJdgmnCeckDetailByJdgmnNo" parameterType="string">
        delete from jdgmn_ceck_detail
         where jdgmn_no = #{jdgmnNo}
    </delete>
</mapper>